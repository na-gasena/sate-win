{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sate",
  "version": "0.1.0",
  "identifier": "club.image.sate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sate",
        "width": 1200,
        "height": 800,
        "fullscreen": true,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
